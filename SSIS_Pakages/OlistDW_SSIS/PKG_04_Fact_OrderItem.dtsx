            <component
              refId="Package\DFT - Load fact_order_item\SRC - order_items"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC - order_items"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    oi.order_id,
    TRY_CAST(oi.order_item_id AS INT) AS order_item_id,
    oi.seller_id,
    oi.product_id,
    o.order_status,
    ds.state AS seller_state,
    dc.state AS customer_state,
    ISNULL(dc.customer_key, -1) AS customer_key,
    ISNULL(pm.payment_method_key, -1) AS primary_payment_method_key,
    ISNULL(CONVERT(INT, CONVERT(CHAR(8), TRY_CAST(o.order_purchase_timestamp AS DATE), 112)), -1) AS order_date_key,
    ISNULL(CONVERT(INT, CONVERT(CHAR(8), TRY_CAST(o.order_approved_at AS DATE), 112)), -1) AS approved_date_key,
    ISNULL(CONVERT(INT, CONVERT(CHAR(8), TRY_CAST(o.order_delivered_customer_date AS DATE), 112)), -1) AS delivered_date_key,
    ISNULL(CONVERT(INT, CONVERT(CHAR(8), TRY_CAST(o.order_estimated_delivery_date AS DATE), 112)), -1) AS estimated_delivery_date_key,
    TRY_CAST(oi.price AS DECIMAL(10,2)) AS price,
    TRY_CAST(oi.freight_value AS DECIMAL(10,2)) AS freight_value,
    1 AS quantity
FROM staging.stg_order_items oi
INNER JOIN staging.stg_orders o ON o.order_id = oi.order_id
INNER JOIN staging.stg_customers c ON c.customer_id = o.customer_id
LEFT OUTER JOIN dwh.dim_customer dc
    ON dc.customer_unique_id = c.customer_unique_id
    AND TRY_CAST(o.order_purchase_timestamp AS DATE) &gt;= dc.effective_from
    AND TRY_CAST(o.order_purchase_timestamp AS DATE) &lt; dc.effective_to
LEFT OUTER JOIN dwh.dim_seller ds ON ds.seller_id = oi.seller_id
LEFT OUTER JOIN (
    SELECT order_id, payment_type,
           ROW_NUMBER() OVER (PARTITION BY order_id
               ORDER BY SUM(TRY_CAST(payment_value AS DECIMAL(18,2))) DESC, payment_type) AS rn
    FROM staging.stg_order_payments
    GROUP BY order_id, payment_type
) pay ON pay.order_id = oi.order_id AND pay.rn = 1
LEFT OUTER JOIN dwh.dim_payment_method pm ON pm.payment_type = pay.payment_type
WHERE NOT EXISTS (
    SELECT 1 FROM dwh.fact_order_item f
    WHERE f.order_id = oi.order_id
      AND f.order_item_id = TRY_CAST(oi.order_item_id AS INT)
)</property>
