              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT LTRIM(RTRIM(t.product_category_name)) AS category_name_portuguese,
       COALESCE(NULLIF(LTRIM(RTRIM(t.product_category_name_english)), N''),
                LTRIM(RTRIM(t.product_category_name))) AS category_name_english
FROM staging.stg_product_category_name_translation t
WHERE t.product_category_name IS NOT NULL
UNION ALL
SELECT DISTINCT LTRIM(RTRIM(p.product_category_name)),
                LTRIM(RTRIM(p.product_category_name))
FROM staging.stg_products p
WHERE p.product_category_name IS NOT NULL
  AND LTRIM(RTRIM(p.product_category_name)) &lt;&gt; N''
  AND NOT EXISTS (SELECT 1
                  FROM staging.stg_product_category_name_translation t2
                  WHERE LTRIM(RTRIM(t2.product_category_name)) = LTRIM(RTRIM(p.product_category_name)));</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
