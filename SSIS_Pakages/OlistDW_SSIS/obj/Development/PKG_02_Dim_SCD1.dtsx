            <component
              refId="Package\DFT - Dim_Geolocation\SRC - geolocation"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC - geolocation"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH g AS (
    SELECT LTRIM(RTRIM(geolocation_zip_code_prefix))     AS zip_code_prefix,
           LOWER(LTRIM(RTRIM(geolocation_city)))         AS city,
           UPPER(LTRIM(RTRIM(geolocation_state)))        AS state,
           TRY_CAST(geolocation_lat AS DECIMAL(9,6))     AS lat,
           TRY_CAST(geolocation_lng AS DECIMAL(9,6))     AS lng
    FROM staging.stg_geolocation
    WHERE geolocation_zip_code_prefix IS NOT NULL
), c AS (
    SELECT zip_code_prefix, city, state,
           ROW_NUMBER() OVER (PARTITION BY zip_code_prefix
                              ORDER BY COUNT(*) DESC, city) AS rn
    FROM g
    GROUP BY zip_code_prefix, city, state
), a AS (
    SELECT zip_code_prefix, AVG(lat) AS lat, AVG(lng) AS lng
    FROM g
    GROUP BY zip_code_prefix
)
SELECT c.zip_code_prefix, c.city, c.state,
       dbo.fn_state_region(c.state)  AS region,
       CAST(a.lat AS DECIMAL(9,6))   AS latitude,
       CAST(a.lng AS DECIMAL(9,6))   AS longitude
FROM c
JOIN a ON a.zip_code_prefix = c.zip_code_prefix
WHERE c.rn = 1;</property>
                <property
