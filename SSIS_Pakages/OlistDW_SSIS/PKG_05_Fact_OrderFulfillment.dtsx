    <DTS:Executable
      DTS:refId="Package\SQL - Merge fact"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C8597037-C7B8-4ADB-8DC4-BDCCB967B0FF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Merge fact"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{08AD23AF-71F0-4600-AA0D-365011B9EC71}"
          SQLTask:SqlStatementSource="MERGE dwh.fact_order_fulfillment AS t&#xA;USING staging.tmp_fact_order_fulfillment AS s ON t.order_id = s.order_id&#xA;WHEN MATCHED AND (&#xA;       t.order_date_key &lt;&gt; s.order_date_key OR t.approved_date_key &lt;&gt; s.approved_date_key&#xA;    OR t.shipped_date_key &lt;&gt; s.shipped_date_key OR t.delivered_date_key &lt;&gt; s.delivered_date_key&#xA;    OR t.estimated_delivery_date_key &lt;&gt; s.estimated_delivery_date_key&#xA;    OR t.order_status_key &lt;&gt; s.order_status_key&#xA;    OR ISNULL(t.days_to_approve, -999999) &lt;&gt; ISNULL(s.days_to_approve, -999999)&#xA;    OR ISNULL(t.days_to_ship,    -999999) &lt;&gt; ISNULL(s.days_to_ship,    -999999)&#xA;    OR ISNULL(t.days_to_deliver, -999999) &lt;&gt; ISNULL(s.days_to_deliver, -999999)&#xA;    OR ISNULL(t.total_days,      -999999) &lt;&gt; ISNULL(s.total_days,      -999999)&#xA;    OR ISNULL(CAST(t.is_delayed AS INT), -1) &lt;&gt; ISNULL(CAST(s.is_delayed AS INT), -1))&#xA;THEN UPDATE SET&#xA;    order_date_key = s.order_date_key, approved_date_key = s.approved_date_key,&#xA;    shipped_date_key = s.shipped_date_key, delivered_date_key = s.delivered_date_key,&#xA;    estimated_delivery_date_key = s.estimated_delivery_date_key,&#xA;    order_status_key = s.order_status_key,&#xA;    days_to_approve = s.days_to_approve, days_to_ship = s.days_to_ship,&#xA;    days_to_deliver = s.days_to_deliver, total_days = s.total_days,&#xA;    is_delayed = s.is_delayed&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (order_id, customer_key, primary_seller_key, order_date_key, approved_date_key,&#xA;            shipped_date_key, delivered_date_key, estimated_delivery_date_key,&#xA;            days_to_approve, days_to_ship, days_to_deliver, total_days, is_delayed, order_status_key)&#xA;    VALUES (s.order_id, s.customer_key, s.primary_seller_key, s.order_date_key, s.approved_date_key,&#xA;            s.shipped_date_key, s.delivered_date_key, s.estimated_delivery_date_key,&#xA;            s.days_to_approve, s.days_to_ship, s.days_to_deliver, s.total_days, s.is_delayed, s.order_status_key);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
