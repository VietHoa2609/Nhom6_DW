            <component
              refId="Package\DFT - Load Fact Order Fulfillment\SRC - Orders"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC - Orders"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH o AS (
    SELECT order_id, customer_id, order_status,
        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM(order_purchase_timestamp)),''))      AS purchase_ts,
        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM(order_approved_at)),''))             AS approved_ts,
        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM(order_delivered_carrier_date)),''))  AS carrier_ts,
        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM(order_delivered_customer_date)),'')) AS delivered_ts,
        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM(order_estimated_delivery_date)),'')) AS estimated_ts
    FROM staging.stg_orders
),
seller_pick AS (   -- người bán của sản phẩm có price lớn nhất trong đơn
    SELECT order_id, seller_id,
           ROW_NUMBER() OVER (PARTITION BY order_id
               ORDER BY TRY_CONVERT(DECIMAL(12,2), price) DESC,
                        TRY_CONVERT(INT, order_item_id), seller_id) AS rn
    FROM staging.stg_order_items
)
SELECT
    o.order_id,
    ISNULL(dc.customer_key, -1)       AS customer_key,
    ISNULL(ds.seller_key, -1)         AS primary_seller_key,
    dbo.fn_date_key(o.purchase_ts)    AS order_date_key,
    dbo.fn_date_key(o.approved_ts)    AS approved_date_key,
    dbo.fn_date_key(o.carrier_ts)     AS shipped_date_key,
    dbo.fn_date_key(o.delivered_ts)   AS delivered_date_key,
    dbo.fn_date_key(o.estimated_ts)   AS estimated_delivery_date_key,
    CASE WHEN o.approved_ts &gt;= o.purchase_ts THEN DATEDIFF(DAY, o.purchase_ts, o.approved_ts) END AS days_to_approve,
    CASE WHEN o.carrier_ts  &gt;= o.approved_ts THEN DATEDIFF(DAY, o.approved_ts, o.carrier_ts) END  AS days_to_ship,
    CASE WHEN v.is_valid = 1 AND o.delivered_ts &gt;= o.carrier_ts
         THEN DATEDIFF(DAY, o.carrier_ts, o.delivered_ts) END  AS days_to_deliver,
    CASE WHEN v.is_valid = 1 AND o.delivered_ts &gt;= o.purchase_ts
         THEN DATEDIFF(DAY, o.purchase_ts, o.delivered_ts) END AS total_days,
    CAST(CASE WHEN v.is_valid = 1 AND o.estimated_ts IS NOT NULL
              THEN CASE WHEN CAST(o.delivered_ts AS DATE) &gt; CAST(o.estimated_ts AS DATE)
                        THEN 1 ELSE 0 END
         END AS BIT)                  AS is_delayed,
    ISNULL(st.order_status_key, -1)   AS order_status_key
FROM o
CROSS APPLY (SELECT CASE WHEN o.order_status = 'delivered' AND o.delivered_ts IS NOT NULL
                         THEN 1 ELSE 0 END AS is_valid) v
LEFT JOIN staging.stg_customers c  ON c.customer_id = o.customer_id
LEFT JOIN dwh.dim_customer dc      ON dc.customer_unique_id = c.customer_unique_id
                                  AND o.purchase_ts &gt;= dc.effective_from
                                  AND o.purchase_ts &lt;  dc.effective_to
LEFT JOIN seller_pick sp           ON sp.order_id = o.order_id AND sp.rn = 1
LEFT JOIN dwh.dim_seller ds        ON ds.seller_id = sp.seller_id
LEFT JOIN dwh.dim_order_status st  ON st.order_status = o.order_status;</property>
                <property
