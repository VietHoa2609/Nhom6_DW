            <component
              refId="Package\DFT - Load Dim Customer SCD2\SRC - Staging Customer"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC - Staging Customer"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT x.customer_unique_id,
       x.customer_city  AS city,
       x.customer_state AS state,
       dbo.fn_state_region(x.customer_state) AS customer_region,
       ISNULL(g.geo_key, -1) AS geo_key
FROM (
    SELECT c.customer_unique_id, c.customer_city, c.customer_state,
           c.customer_zip_code_prefix,
           ROW_NUMBER() OVER (PARTITION BY c.customer_unique_id
               ORDER BY TRY_CONVERT(DATETIME2(0), o.order_purchase_timestamp) DESC,
                        c.customer_id) AS rn
    FROM staging.stg_customers c
    LEFT JOIN staging.stg_orders o ON o.customer_id = c.customer_id
) x
LEFT JOIN dwh.dim_geolocation g ON g.zip_code_prefix = x.customer_zip_code_prefix
WHERE x.rn = 1;</property>
