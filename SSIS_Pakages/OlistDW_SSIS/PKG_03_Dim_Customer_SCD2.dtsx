    <DTS:Executable
      DTS:refId="Package\SQL - Seed customer history"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9F59F273-98D2-4F0B-807B-7180C53DB3AE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Seed customer history"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{08AD23AF-71F0-4600-AA0D-365011B9EC71}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT 1 FROM dwh.dim_customer WHERE customer_key &lt;&gt; -1)&#xA;BEGIN&#xA;    ;WITH ord AS (&#xA;        SELECT c.customer_unique_id, c.customer_id, c.customer_city, c.customer_state,&#xA;               c.customer_zip_code_prefix,&#xA;               TRY_CONVERT(DATETIME2(0), o.order_purchase_timestamp) AS purchase_ts&#xA;        FROM staging.stg_customers c&#xA;        JOIN staging.stg_orders o ON o.customer_id = c.customer_id&#xA;    ),&#xA;    flagged AS (&#xA;        SELECT *,&#xA;               CASE WHEN LAG(customer_id) OVER (PARTITION BY customer_unique_id ORDER BY purchase_ts, customer_id) IS NOT NULL&#xA;                     AND ISNULL(LAG(customer_city)  OVER (PARTITION BY customer_unique_id ORDER BY purchase_ts, customer_id), N'#') = ISNULL(customer_city, N'#')&#xA;                     AND ISNULL(LAG(customer_state) OVER (PARTITION BY customer_unique_id ORDER BY purchase_ts, customer_id), N'#') = ISNULL(customer_state, N'#')&#xA;                    THEN 0 ELSE 1 END AS is_new&#xA;        FROM ord&#xA;    ),&#xA;    grp AS (&#xA;        SELECT *, SUM(is_new) OVER (PARTITION BY customer_unique_id&#xA;                                    ORDER BY purchase_ts, customer_id&#xA;                                    ROWS UNBOUNDED PRECEDING) AS seg_no&#xA;        FROM flagged&#xA;    ),&#xA;    seg AS (&#xA;        SELECT customer_unique_id, seg_no, customer_city, customer_state, customer_zip_code_prefix,&#xA;               MIN(purchase_ts) OVER (PARTITION BY customer_unique_id, seg_no) AS first_ts,&#xA;               ROW_NUMBER() OVER (PARTITION BY customer_unique_id, seg_no&#xA;                                  ORDER BY purchase_ts DESC, customer_id) AS rn&#xA;        FROM grp&#xA;    ),&#xA;    ver AS (&#xA;        SELECT v.customer_unique_id, v.seg_no, v.customer_city, v.customer_state, v.first_ts,&#xA;               ISNULL(geo.geo_key, -1) AS geo_key&#xA;        FROM seg v&#xA;        LEFT JOIN dwh.dim_geolocation geo ON geo.zip_code_prefix = v.customer_zip_code_prefix&#xA;        WHERE v.rn = 1&#xA;    )&#xA;    INSERT INTO dwh.dim_customer&#xA;        (customer_unique_id, city, state, customer_region, geo_key, effective_from, effective_to, is_current)&#xA;    SELECT customer_unique_id, customer_city, customer_state,&#xA;           dbo.fn_state_region(customer_state), geo_key,&#xA;           CASE WHEN seg_no = 1 THEN CAST('1900-01-01' AS DATETIME2(0)) ELSE first_ts END,&#xA;           ISNULL(LEAD(first_ts) OVER (PARTITION BY customer_unique_id ORDER BY seg_no),&#xA;                  CAST('9999-12-31' AS DATETIME2(0))),&#xA;           CASE WHEN LEAD(first_ts) OVER (PARTITION BY customer_unique_id ORDER BY seg_no) IS NULL&#xA;                THEN 1 ELSE 0 END&#xA;    FROM ver;&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
