      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Update status"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{08AD23AF-71F0-4600-AA0D-365011B9EC71}"
          SQLTask:SqlStatementSource="UPDATE f SET f.order_status_key = ful.order_status_key,&#xA;             f.delivered_date_key = ful.delivered_date_key&#xA;FROM dwh.fact_order_item f&#xA;JOIN dwh.fact_order_fulfillment ful ON ful.order_id = f.order_id&#xA;WHERE f.order_status_key &lt;&gt; ful.order_status_key&#xA;   OR f.delivered_date_key &lt;&gt; ful.delivered_date_key;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
